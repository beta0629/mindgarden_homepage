# Inquiry form destination. The contact server action POSTs JSON here.
# Leave this empty until a destination exists. Do not put a secret or a live URL in this file.
# When CONTACT_ENDPOINT is unset, the form shows the failure message from content and does not report success.
CONTACT_ENDPOINT=

# Absolute site origin used for canonical URLs, sitemap, and JSON-LD.
# Set this before a production deploy. Do not point it at a domain until DNS is ready.
NEXT_PUBLIC_SITE_URL=

# Naver Search Advisor site verification code, if issued.
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
